# Cloudflare Pages serves HTTP Range requests for static files automatically,
# which is what pmtiles needs. These rules just tune caching.

# Vite fingerprints these filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted basemap glyphs and sprites change only when regenerated.
/fonts/*
  Cache-Control: public, max-age=604800
/sprites/*
  Cache-Control: public, max-age=604800

# The city's official Equity Area map. A stable name and effectively static
# content — the city has clarified it once and would announce a change —
# but not `immutable`: this file decides whether a rider is told they are
# owed a discount, so a corrected boundary should reach them within a day
# rather than whenever their browser next evicts it.
/equity-areas.geojson
  Cache-Control: public, max-age=86400

# The basemap archive has a stable name; cache a day so a regen propagates.
/denver.pmtiles
  Cache-Control: public, max-age=86400
